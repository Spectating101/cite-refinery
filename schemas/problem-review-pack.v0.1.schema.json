{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/problem-review-pack.v0.1.schema.json",
  "title": "Problem Commons External Review Pack V0.1",
  "type": "object",
  "required": ["schema", "audience", "problem_id", "instructions", "problem", "stage_profiles", "governance", "rubric", "response", "privacy_note"],
  "properties": {
    "schema": {"const": "problem-review-pack/v0.1"},
    "audience": {"enum": ["owner", "reviewer", "solver"]},
    "problem_id": {"type": "string", "pattern": "^problem:"},
    "instructions": {"type": "array", "items": {"type": "string"}},
    "problem": {"type": "object"},
    "stage_profiles": {"type": "array", "items": {"type": "object"}},
    "governance": {"type": "array", "items": {"type": "object"}},
    "rubric": {
      "type": "object",
      "required": ["name", "items", "scoring"],
      "properties": {
        "name": {"enum": ["owner_agreement", "reviewer_quality", "solver_comprehension"]},
        "items": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "scoring": {"type": "string"}
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["item_scores", "disagreement_notes", "material_errors", "coaching_received"],
      "properties": {
        "item_scores": {"type": "array", "items": {"type": ["integer", "null"], "enum": [0, 1, null]}},
        "disagreement_notes": {"type": "array", "items": {"type": "string"}},
        "material_errors": {"type": "array", "items": {"type": "string"}},
        "coaching_received": {"type": "boolean"},
        "reframe_required": {"type": "boolean"},
        "publish_recommendation": {"type": "string"},
        "review_notes": {"type": "string"},
        "selected_subproblem_id": {"type": ["string", "null"]},
        "minutes_to_useful_edge": {"type": ["number", "null"], "minimum": 0},
        "usefulness_rating": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "serious_attempt": {"type": "boolean"},
        "abandoned": {"type": "boolean"},
        "abandonment_reason": {"type": "string"},
        "observer_notes": {"type": "string"},
        "arm": {"type": "string"}
      },
      "additionalProperties": false
    },
    "experiment": {
      "type": "object",
      "required": ["schema", "participant_id", "sequence_index", "pair_position", "arm", "comparison_note"],
      "properties": {
        "schema": {"const": "problem-solver-experiment/v0.1"},
        "participant_id": {"type": "string", "minLength": 1},
        "sequence_index": {"type": "integer", "minimum": 0},
        "pair_position": {"type": "integer", "enum": [0, 1]},
        "arm": {"enum": ["ordinary_brief", "problem_packet"]},
        "comparison_note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "privacy_note": {"type": "string"}
  },
  "additionalProperties": false
}
