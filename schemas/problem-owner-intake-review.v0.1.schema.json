{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem-owner-intake-review/v0.1",
  "title": "Problem Commons Owner Intake Review V0.1",
  "type": "object",
  "required": ["schema", "intake_id", "problem_id", "potential_owner", "instructions", "problem", "rubric", "response", "allowed_dispositions"],
  "properties": {
    "schema": {"const": "problem-owner-intake-review/v0.1"},
    "intake_id": {"type": "string", "pattern": "^intake:"},
    "problem_id": {"type": "string", "pattern": "^problem:"},
    "potential_owner": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string"},
    "instructions": {"type": "array", "items": {"type": "string"}},
    "problem": {"type": "object"},
    "rubric": {
      "type": "object",
      "required": ["name", "items", "scoring"],
      "properties": {
        "name": {"const": "owner_agreement"},
        "items": {"type": "array", "items": {"type": "string"}},
        "scoring": {"type": "string"}
      }
    },
    "response": {
      "type": "object",
      "required": ["source_still_current", "owner_identity_and_role_correct", "item_scores", "factual_corrections", "missing_constraints", "desired_outcome_or_priority", "acceptable_work_subproblem_ids", "unacceptable_work_subproblem_ids", "access_or_safeguarding_corrections", "funding_or_resource_notes", "reframe_required", "disposition", "owner_notes"],
      "properties": {
        "source_still_current": {"type": ["boolean", "null"]},
        "owner_identity_and_role_correct": {"type": ["boolean", "null"]},
        "item_scores": {"type": "array", "items": {"type": ["integer", "null"], "minimum": 0, "maximum": 1}},
        "factual_corrections": {"type": "array", "items": {"type": "string"}},
        "missing_constraints": {"type": "array", "items": {"type": "string"}},
        "desired_outcome_or_priority": {"type": "string"},
        "acceptable_work_subproblem_ids": {"type": "array", "items": {"type": "string"}},
        "unacceptable_work_subproblem_ids": {"type": "array", "items": {"type": "string"}},
        "access_or_safeguarding_corrections": {"type": "array", "items": {"type": "string"}},
        "funding_or_resource_notes": {"type": "array", "items": {"type": "string"}},
        "reframe_required": {"type": "boolean"},
        "disposition": {"enum": ["confirm", "reframe", "stale", "already-resolved", "decline", "undecided"]},
        "owner_notes": {"type": "string"}
      }
    },
    "allowed_dispositions": {"type": "array", "items": {"type": "string"}},
    "privacy_note": {"type": "string"}
  },
  "additionalProperties": false
}
