{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/problem-commons/problem-packet.v0.1.schema.json",
  "title": "Problem Commons Packet V0.1",
  "type": "object",
  "required": ["id", "title", "observed_condition", "unresolved_core", "steward", "status", "authority_boundary", "evidence", "success_criteria", "subproblems"],
  "properties": {
    "id": {"type": "string", "pattern": "^problem:"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "observed_condition": {"type": "string", "minLength": 1},
    "unresolved_core": {"type": "string", "minLength": 1},
    "steward": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "researching", "verified", "open", "partially_resolved", "piloting", "deployed", "monitoring", "resolved", "reframed", "retired", "invalidated"]},
    "visibility": {"enum": ["private", "restricted", "public"]},
    "domain": {"type": "string"},
    "geography": {"type": ["string", "null"]},
    "time_scope": {"type": ["string", "null"]},
    "problem_owner": {"type": "string"},
    "sponsor": {"type": "string"},
    "affected_actors": {"type": "array", "items": {"type": "string"}},
    "beneficiaries": {"type": "array", "items": {"type": "string"}},
    "disputes_uncertainty": {"type": "array", "items": {"type": "string"}},
    "diagnosis": {"type": "array", "items": {"type": "string"}},
    "prior_attempts": {"type": "array", "items": {"type": "string"}},
    "knowledge_frontier": {"type": "array", "items": {"type": "string"}},
    "capability_frontier": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "authority_boundary": {"type": "string", "minLength": 1},
    "implementation_pathway": {"type": "array", "items": {"type": "string"}},
    "rights_notes": {"type": "string"},
    "funding_notes": {"type": "string"},
    "contribution_license": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "data_resources": {"type": "array", "items": {"$ref": "#/$defs/dataResource"}},
    "capability_needs": {"type": "array", "items": {"$ref": "#/$defs/capabilityNeed"}},
    "success_criteria": {"type": "array", "items": {"$ref": "#/$defs/successCriterion"}},
    "subproblems": {"type": "array", "items": {"$ref": "#/$defs/subproblem"}},
    "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
    "outcomes": {"type": "array", "items": {"$ref": "#/$defs/outcome"}},
    "external_refs": {"type": "array", "items": {"$ref": "#/$defs/externalRef"}},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["id", "source", "locator", "summary", "confidence", "visibility"],
      "properties": {
        "id": {"type": "string"}, "source": {"type": "string"}, "locator": {"type": "string"}, "summary": {"type": "string"}, "confidence": {"type": "string"},
        "observed_at": {"type": ["string", "null"]}, "visibility": {"enum": ["private", "restricted", "public"]}, "rights": {"type": "string"},
        "disputes": {"type": "array", "items": {"type": "string"}}, "provenance": {"type": "object"}
      }
    },
    "dataResource": {
      "type": "object",
      "required": ["id", "title", "access", "visibility"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string"}, "access": {"type": "string"}, "uri": {"type": ["string", "null"]}, "license": {"type": "string"},
        "sensitivity": {"type": "string"}, "visibility": {"enum": ["private", "restricted", "public"]}, "notes": {"type": "string"}
      }
    },
    "capabilityNeed": {
      "type": "object",
      "required": ["id", "name", "state"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "state": {"type": "string"}, "description": {"type": "string"},
        "capability_refs": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "successCriterion": {
      "type": "object",
      "required": ["id", "metric", "target", "measurement"],
      "properties": {
        "id": {"type": "string"}, "metric": {"type": "string"}, "target": {"type": "string"}, "measurement": {"type": "string"}, "falsification": {"type": "string"},
        "baseline": {"type": "string"}, "guardrails": {"type": "array", "items": {"type": "string"}}
      }
    },
    "subproblem": {
      "type": "object",
      "required": ["id", "title", "description", "kind", "status"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"}, "kind": {"type": "string"}, "status": {"type": "string"},
        "prerequisites": {"type": "array", "items": {"type": "string"}}, "capability_refs": {"type": "array", "items": {"type": "string"}},
        "skill_tags": {"type": "array", "items": {"type": "string"}}, "interest_tags": {"type": "array", "items": {"type": "string"}},
        "expected_outputs": {"type": "array", "items": {"type": "string"}}, "effort": {"type": "string"},
        "participation_modes": {"type": "array", "items": {"type": "string"}}, "required_credentials": {"type": "array", "items": {"type": "string"}}
      }
    },
    "attempt": {
      "type": "object",
      "required": ["id", "problem_id", "title", "contributor", "status", "subproblem_ids"],
      "properties": {
        "id": {"type": "string"}, "problem_id": {"type": "string"}, "title": {"type": "string"}, "contributor": {"type": "string"},
        "subproblem_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"enum": ["draft", "active", "submitted", "accepted", "rejected", "withdrawn", "completed"]},
        "capability_refs": {"type": "array", "items": {"type": "string"}}, "artifact_refs": {"type": "array", "items": {"type": "string"}},
        "experiment_refs": {"type": "array", "items": {"type": "string"}}, "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}, "credit": {"type": "array", "items": {"type": "string"}}, "created_at": {"type": "string"}, "updated_at": {"type": "string"}
      }
    },
    "outcome": {
      "type": "object",
      "required": ["id", "problem_id", "summary", "observed_change", "disposition", "attribution"],
      "properties": {
        "id": {"type": "string"}, "problem_id": {"type": "string"}, "summary": {"type": "string"}, "observed_change": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}, "disposition": {"type": "string"}, "attribution": {"type": "string"}, "observed_at": {"type": "string"}
      }
    },
    "externalRef": {
      "type": "object",
      "required": ["id", "system", "ref", "relation", "visibility"],
      "properties": {
        "id": {"type": "string"}, "system": {"type": "string"}, "ref": {"type": "string"}, "relation": {"type": "string"},
        "visibility": {"enum": ["private", "restricted", "public"]}, "label": {"type": "string"}, "notes": {"type": "string"}
      }
    }
  }
}
