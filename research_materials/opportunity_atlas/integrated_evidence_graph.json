    {
      "id": "mechanism:battery_recycling_economics",
      "type": "interpreted_operational_mechanism",
      "label": "Battery recycling profitability varies with pack design, logistics, labor and recovery process; a technically feasible regeneration method is not a validated profitable operation.",
      "evidence_status": "investigator_candidate_not_reviewed_for_entailment"
    },
    {
      "id": "mechanism:classroom_ventilation_outcomes",
      "type": "interpreted_operational_mechanism",
      "label": "Schools can show high indoor CO₂ and respiratory burden without evidence that a given sensing or ventilation intervention improves clinical outcomes in those classrooms.",
      "evidence_status": "investigator_candidate_not_reviewed_for_entailment"
    },
    {
      "id": "mechanism:dog_population_identity_and_movement",
      "type": "interpreted_operational_mechanism",
      "label": "Free-roaming dog counts and vaccination campaigns need individual/temporal reconciliation and movement understanding, while program outputs do not alone establish sustained population or rabies effects.",
      "evidence_status": "investigator_candidate_not_reviewed_for_entailment"
    },
    {
      "id": "mechanism:ewaste_toxicant_control",
      "type": "interpreted_operational_mechanism",
      "label": "Informal and formal electronic recycling expose workers and communities to metals and flame retardants, while an environmental modeling toolkit cannot replace occupational monitoring or hazard controls.",
      "evidence_status": "investigator_candidate_not_reviewed_for_entailment"
    },
    {
      "id": "mechanism:flood_warning_to_impact",
      "type": "interpreted_operational_mechanism",
      "label": "Flood vulnerability and community early-warning deployments can be documented separately without knowing whether warnings prevented injury, drowning, displacement or service disruption.",
      "evidence_status": "investigator_candidate_not_reviewed_for_entailment"
    },
    {
      "id": "mechanism:food_redistribution_outcomes",
      "type": "interpreted_operational_mechanism",
      "label": "Food redistribution programs often measure recovered kilograms or pickup performance while actual beneficiary nutritional and net lifecycle benefits remain insufficiently linked to real operations.",
      "evidence_status": "investigator_candidate_not_reviewed_for_entailment"
    },
    {
      "id": "mechanism:gig_worker_algorithmic_harm",
      "type": "interpreted_operational_mechanism",
      "label": "Food-delivery platforms face reported accident and health risks associated with workload and algorithmic management; no listed software implementation here is independently shown to reduce worker injury.",
      "evidence_status": "investigator_candidate_not_reviewed_for_entailment"
    },
    {
      "id": "mechanism:heat_warning_to_protective_action",
      "type": "interpreted_operational_mechanism",
      "label": "Heat mortality projections and early-warning plans are widespread sources of concern, but a meteorological warning is not itself evidence that vulnerable households received or acted on protection.",
      "evidence_status": "investigator_candidate_not_reviewed_for_entailment"
    },
