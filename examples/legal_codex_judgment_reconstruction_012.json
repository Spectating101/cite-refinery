      "id": "cmp_remedy_boundary",
      "left_holding": "uk_appeals_mixed",
      "right_holding": "nl_3536_disposition",
      "transfer_status": "remedies_non_equivalent",
      "analysis": "The criminal court actually quashed convictions in 39 appeals but dismissed three, whereas the Dutch administrative court annulled the administrative decision and required a reconsideration. Neither ruling alone establishes monetary compensation or a broader quantified reduction in institutional harm.",
      "equivalence_established": false,
      "measured_effect_difference": null,
      "foreign_rule_applied": false
    },
    {
      "id": "cmp_dutch_split",
      "left_holding": "nl_3535_entitlement",
      "right_holding": "nl_3536_discretion",
      "transfer_status": "distinct_domestic_procedures",
      "analysis": "Same-day Dutch judgments supply complementary but analytically distinct legal changes: 3535 allows proportionate determination of entitlement when costs are partially paid; 3536 concerns balancing interests and reducing or waiving recovery. They are not a single automatic administrative exemption.",
