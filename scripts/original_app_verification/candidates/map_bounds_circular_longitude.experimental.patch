+      for coordinate in candidateCoordinates
@@ -20,0 +42,16 @@
+
+      if angleName == "longitude" && angles.length > 1
+        # Circular minimal covering arc; prototype, not a complete map viewport.
+        wrapped = angles.map (angle) -> (angle + 360) % 360
+        wrapped.sort (a, b) -> a - b
+        biggestGap = -1
+        startIndex = 0
+        for i in [0...wrapped.length]
+          nextIndex = (i + 1) % wrapped.length
+          nextAngle = if nextIndex == 0 then wrapped[0] + 360 else wrapped[nextIndex]
+          gap = nextAngle - wrapped[i]
+          if gap > biggestGap
+            biggestGap = gap
+            startIndex = nextIndex
+        center = (wrapped[startIndex] + (360 - biggestGap)/2) % 360
+        return if center > 180 then center - 360 else center
