+      validNumber = (value) -> typeof value == "number" && isFinite(value)
+      candidateCoordinates = coordinates.filter (coordinate) ->
+        validNumber(coordinate.latitude) && validNumber(coordinate.longitude)
+
+      # Experimental per-instance bounds; these options are not currently
+      # declared in the real OFN config and need application integration.
+      bounds =
+        latMin: openStreetMapConfig.open_street_map_latitude_min
+        latMax: openStreetMapConfig.open_street_map_latitude_max
+        lngMin: openStreetMapConfig.open_street_map_longitude_min
+        lngMax: openStreetMapConfig.open_street_map_longitude_max
+
+      boundsConfigured = validNumber(bounds.latMin) && validNumber(bounds.latMax) && validNumber(bounds.lngMin) && validNumber(bounds.lngMax)
+      if boundsConfigured
+        candidateCoordinates = candidateCoordinates.filter (coordinate) ->
+          coordinate.latitude >= bounds.latMin && coordinate.latitude <= bounds.latMax &&
+          coordinate.longitude >= bounds.lngMin && coordinate.longitude <= bounds.lngMax
+
+      if candidateCoordinates.length == 0
+        return if angleName == "latitude" then openStreetMapConfig.open_street_map_default_latitude else openStreetMapConfig.open_street_map_default_longitude
+
@@ -19 +40 @@
